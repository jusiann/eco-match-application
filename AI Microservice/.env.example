# Eşleştirme için kullanılan fine-tuned model — sınıflandırma ayrı, kendi
# modelini kullanır (bkz. app/classifier.py, kod içinde sabit tanımlı).
MODEL_NAME=./fine_tuned_model
VECTOR_DIM=768
LOG_LEVEL=INFO

# NOT: Windows'ta yerel bir PostgreSQL servisi 5432'yi kullanıyorsa,
# docker-compose.yml container'ı 5433'e map'ler — buna göre ayarla.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ecomatch
DB_USER=ecomatch
DB_PASSWORD=1Eco2Meko3Seko

# Hibrit arama: BM25 ağırlığı; (1 - BM25_ALPHA) SBERT ağırlığı olarak kullanılır
BM25_ALPHA=0.4
