PORT=3000

# PostgreSQL (Supabase / Local PostgreSQL / Neon vb.)
# PgBouncer / Connection Pooler URL (Uygulama sorguları için)
DATABASE_URL="postgresql://postgres:password@localhost:5432/eco_match?schema=public"

# Direct URL (Migration ve seed işlemleri için doğrudan bağlantı)
DIRECT_URL="postgresql://postgres:password@localhost:5432/eco_match?schema=public"

# JWT Secret Key
JWT_SECRET_KEY="guclu-ve-rastgele-bir-jwt-anahtari-yazin"

# Public DPP/QR linkleri bu domain'e göre kurulur (bkz. K-21). Prod'da gerçek domain'e
# çevrilmeli. DPP imzası (HMAC) da JWT_SECRET_KEY ile üretilir, ayrı bir anahtar yok.
PUBLIC_BASE_URL="http://localhost:3000"

# Faz 3.3 chatbot -- ClaudeClientService şu an DUMMY (bkz. K-31), bu anahtar henüz
# okunmuyor. Gerçek Anthropic SDK entegrasyonu eklenince kullanılacak.
