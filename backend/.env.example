PORT=3000

# PostgreSQL (Supabase / Local PostgreSQL / Neon vb.)
# backend/docker-compose.yml ile DB'yi Docker'da çalıştırıyorsan host portu 5432
# değil 5434 (bkz. docs/10-gelistirme-rehberi.md) -- backend de Docker içinde
# çalışıyorsa bu satırlar önemsiz, compose DATABASE_URL/DIRECT_URL'i "db" host'una
# göre kendi ortam değişkenleriyle ezer.
# PgBouncer / Connection Pooler URL (Uygulama sorguları için)
DATABASE_URL="postgresql://postgres:1397@localhost:5432/eco_match?schema=public"

# Direct URL (Migration ve seed işlemleri için doğrudan bağlantı)
DIRECT_URL="postgresql://postgres:1397@localhost:5432/eco_match?schema=public"

# JWT Secret Key
JWT_SECRET_KEY="guclu-ve-rastgele-bir-jwt-anahtari-yazin"

API_URL="http://localhost:3000/v1"

# Dijital Ürün Pasaportu QR/PDF bağlantılarının önüne konan KULLANICIYA AÇIK adres
# (dpp.service.ts#baseUrl). QR kodu telefondan okutulacağı için burası, kullanıcının
# tarayıcısından erişilebilen adres olmalı -- konteyner içi "backend:3000" DEĞİL.
# Tüm yığın Docker'da çalışıyorsa bu, web konteynerinin (nginx) adresidir:
#   PUBLIC_BASE_URL="http://localhost:8080"
# Tanımsız bırakılırsa http://localhost:3000 varsayılır.
PUBLIC_BASE_URL="http://localhost:8080"

# Virgülle ayrılmış CORS origin listesi. Tanımsız bırakılırsa isteğin kendi origin'i
# yansıtılır (geliştirme kolaylığı) -- ÜRETİMDE MUTLAKA AYARLAYIN. Frontend'i ayrı
# bir portta `npm run dev` ile çalıştırıyorsanız o adresi buraya ekleyin.
# Docker'da web ve backend aynı origin üzerinden konuştuğu için (nginx proxy)
# bu ayar oradaki akışta hiç devreye girmez.
# CORS_ORIGINS="http://localhost:3002,http://localhost:8080"

# AI Microservice (docs/07-ai-entegrasyonu.md) taban adresi. Backend de Docker
# içinde çalışıyorsa docker-compose.yml bunu "http://ai-service:8000" ile ezer
# (compose ağı içindeki servis adı) -- bu satır sadece backend'i native
# çalıştırırken (AI servisi de native veya kendi container'ında) devreye girer.
AI_SERVICE_URL="http://localhost:8000"